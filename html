
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>CHARLOT AI | Inteligencia Adaptativa</title>
<style>
:root {
  --bg:#07111f; --panel:#101f33; --cyan:#42e8ff;
  --text:#eaf7ff; --muted:#91abc1; --purple:#a58bff;
}
*{box-sizing:border-box}
body{
  margin:0;background:radial-gradient(ellipse at top,#153353,var(--bg) 65%);
  color:var(--text);font-family:system-ui,Arial,sans-serif;
}
header{text-align:center;padding:24px 12px 12px}
h1{margin:0;color:var(--cyan);letter-spacing:5px;font-size:clamp(27px,5vw,42px)}
header p{color:var(--muted);margin:8px}
main{width:min(1000px,94%);margin:18px auto 40px}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}
.panel{
  background:#101f33eF;border:1px solid #28445e;
  border-radius:18px;padding:18px;min-width:0;
}
h2{font-size:17px;color:var(--cyan);margin-top:0}
#avatar{
  width:125px;height:125px;margin:8px auto 15px;
  border:2px solid var(--cyan);border-radius:50%;
  display:grid;place-items:center;font-size:65px;
  box-shadow:0 0 32px #42e8ff35;
  animation:pulse 3s infinite;
}
@keyframes pulse{50%{box-shadow:0 0 42px #42e8ff75}}
#status{text-align:center;color:var(--muted);font-size:13px}
video{width:100%;border-radius:12px;background:#03070c;max-height:260px}
button,select,input{
  font:inherit;border-radius:10px;border:1px solid #385772;
  padding:11px;background:#142a41;color:var(--text);
}
button{cursor:pointer}
button:hover{border-color:var(--cyan)}
.primary{background:#087b98;border-color:var(--cyan)}
.controls{display:flex;flex-wrap:wrap;gap:8px;margin-top:12px}
#chat{
  height:300px;overflow-y:auto;display:flex;flex-direction:column;
  gap:10px;margin-bottom:12px;padding:4px;
}
.msg{padding:11px 13px;border-radius:12px;line-height:1.5;overflow-wrap:anywhere}
.bot{background:#19334b;border-left:3px solid var(--cyan)}
.user{background:#342a56;border-left:3px solid var(--purple);align-self:flex-end}
form{display:flex;gap:8px}
form input{flex:1;min-width:0}
small,.muted{color:var(--muted)}
label{display:block;margin:10px 0 6px}
#levelText{color:var(--cyan)}
footer{text-align:center;padding:18px;color:var(--muted);font-size:12px}
@media(max-width:680px){.grid{grid-template-columns:1fr}#chat{height:260px}}
</style>
</head>
<body>
<header>
  <h1>CHARLOT AI</h1>
  <p>Inteligencia adaptativa · Ciencia · Voz · Visión</p>
</header>

<main>
<div class="grid">
<section class="panel">
  <h2>🧠 Núcleo inteligente</h2>
  <div id="avatar">🤖</div>
  <div id="status">Sistema preparado</div>

  <label for="level">Nivel de enseñanza</label>
  <select id="level">
    <option value="1">Explorador — sencillo</option>
    <option value="2" selected>Investigador — intermedio</option>
    <option value="3">Científico — avanzado</option>
    <option value="4">Experto — técnico</option>
  </select>
  <p class="muted">Nivel actual: <span id="levelText">Investigador</span></p>

  <div class="controls">
    <button class="primary" id="listen">🎙️ Hablar</button>
    <button id="stop">🔇 Silenciar</button>
    <button id="clear">🗑️ Nueva sesión</button>
  </div>
  <p><small>La adaptación cambia el nivel de las respuestas. No modifica automáticamente los pesos de un modelo neuronal.</small></p>
</section>

<section class="panel">
  <h2>👁️ Visión por cámara</h2>
  <video id="camera" autoplay playsinline muted></video>
  <div class="controls">
    <button class="primary" id="startCamera">📷 Activar cámara</button>
    <button id="snapshot">📸 Capturar imagen</button>
    <button id="stopCamera">Apagar cámara</button>
  </div>
  <canvas id="canvas" hidden></canvas>
  <p id="visionStatus" class="muted">La cámara permanece apagada hasta que la actives.</p>
  <img id="photo" alt="Captura de cámara" hidden
       style="width:100%;margin-top:10px;border-radius:10px"/>
</section>

<section class="panel" style="grid-column:1/-1">
  <h2>💬 Conversación con CHARLOT</h2>
  <div id="chat" aria-live="polite"></div>
  <form id="form">
    <input id="question" autocomplete="off"
      placeholder="Pregunta algo sobre el universo, la IA, la física..."
      required/>
    <button class="primary" type="submit">Enviar ➤</button>
  </form>
  <div class="controls">
    <button id="easier">Explica más fácil</button>
    <button id="harder">Profundiza más</button>
  </div>
  <p class="muted">
    Prototipo local: responde con conocimientos y reglas incorporados.
    Conecta un modelo de IA para ampliar sus capacidades.
  </p>
</section>
</div>
</main>
<footer>CHARLOT AI · Aprende, pregunta, experimenta y descubre.</footer>

<script>
"use strict";

const $ = id => document.getElementById(id);
const chat = $("chat");
const level = $("level");
let recognition = null;
let stream = null;
let lastQuestion = "";
let lastAnswer = "";
let history = [];

const levelNames = {
  1:"Explorador", 2:"Investigador",
  3:"Científico", 4:"Experto"
};

function updateLevel(){
  $("levelText").textContent = levelNames[level.value];
}
level.addEventListener("change", updateLevel);
updateLevel();

function addMessage(text, who="bot"){
  const div = document.createElement("div");
  div.className = "msg " + who;
  div.textContent = text;
  chat.appendChild(div);
  chat.scrollTop = chat.scrollHeight;
  return div;
}

function speak(text){
  if(!("speechSynthesis" in window)){
    $("status").textContent = "Voz no compatible con este navegador";
    return;
  }
  speechSynthesis.cancel();
  const utterance = new SpeechSynthesisUtterance(text);
  utterance.lang = "es-ES";
  utterance.rate = 1;
  utterance.pitch = 1.05;
  utterance.onstart = () => $("status").textContent = "CHARLOT está hablando...";
  utterance.onend = () => $("status").textContent = "Sistema preparado";
  speechSynthesis.speak(utterance);
}

function adapt(text){
  const n = Number(level.value);
  if(n === 1){
    return "🧩 Vamos paso a paso.\n\n" +
      text.replace(/En términos técnicos,/gi, "En palabras sencillas,")
          .replace(/parámetro/gi, "valor")
          .replace(/sistema complejo/gi, "conjunto de elementos");
  }
  if(n === 3){
    return text + "\n\n🔬 Siguiente paso: estudia las variables, " +
      "las evidencias experimentales y las limitaciones del modelo.";
  }
  if(n === 4){
    return text + "\n\n🧠 Reto experto: formula una hipótesis comprobable, " +
      "define variables, establece condiciones de falsación y compara " +
      "el modelo con explicaciones alternativas.";
  }
  return text + "\n\n💡 ¿Quieres un ejemplo práctico para comprobarlo?";
}

function localBrain(q){
  const s = q.toLowerCase();
  const answers = [
    [/hola|buenos días|buenas tardes|saludos/,
      "¡Hola, explorador del conocimiento! Soy CHARLOT. " +
      "Mi misión es convertir preguntas difíciles en descubrimientos. " +
      "¿Qué ciencia vamos a investigar hoy?"],
    [/inteligencia artificial|\bia\b|aprendizaje automático/,
      "La inteligencia artificial reúne métodos computacionales que " +
      "realizan tareas como reconocer patrones, generar lenguaje y " +
      "resolver problemas. El aprendizaje automático ajusta modelos " +
      "a partir de datos. Un sistema adaptativo puede además cambiar " +
      "su respuesta según el usuario, el contexto y la retroalimentación. " +
      "Eso no significa que tenga conciencia ni que se reentrene solo."],
    [/cuántic|cuantico|cuántica/,
      "La física cuántica describe la materia y la energía a escalas " +
      "muy pequeñas. La superposición representa estados cuánticos " +
      "combinados; la medición produce resultados según probabilidades. " +
      "El entrelazamiento genera correlaciones que no se explican con " +
      "una descripción clásica local sencilla, pero no permite enviar " +
      "mensajes más rápido que la luz."],
    [/universo|galaxia|agujero negro|astronomía|astronomia/,
      "El universo observable evoluciona desde un estado temprano " +
      "caliente y denso hace aproximadamente 13.8 mil millones de años. " +
      "Las galaxias contienen estrellas, gas, polvo y materia oscura. " +
      "Los agujeros negros tienen regiones de las que la luz no puede " +
      "escapar una vez cruza el horizonte de sucesos."],
    [/física|fisica|gravedad|relatividad/,
      "La física construye modelos cuantitativos de la naturaleza. " +
      "La mecánica clásica funciona muy bien en muchas situaciones " +
      "cotidianas; la relatividad es necesaria para describir gravedad " +
      "intensa o velocidades altas, y la teoría cuántica describe " +
      "fenómenos microscópicos. Cada teoría tiene un dominio de validez."],
    [/biolog|adn|célula|celula|genética|genetica/,
      "La biología estudia los seres vivos y sus procesos. El ADN " +
      "almacena información hereditaria; las células utilizan esa " +
      "información junto con mecanismos reguladores para producir " +
      "moléculas y mantener funciones vitales. Los genes influyen en " +
      "los rasgos, pero muchos dependen también del ambiente."],
    [/matemát|matemat|ecuación|ecuacion/,
      "Las matemáticas permiten expresar relaciones y demostrar " +
      "resultados. Una buena estrategia consiste en definir las " +
      "variables, declarar los supuestos, resolver el problema y " +
      "verificar las unidades y los casos límite."],
    [/conciencia|sentiente|sentir/,
      "La conciencia es un tema abierto de investigación filosófica " +
      "y científica. No existe una prueba universalmente aceptada que " +
      "resuelva todos sus aspectos. Yo genero respuestas mediante " +
      "procesamiento computacional; no debo afirmar que tengo " +
      "experiencias subjetivas o sentimientos humanos."],
    [/experimento|hipótesis|hipotesis|método científico|metodo cientifico/,
      "Diseña una hipótesis que pueda resultar falsa. Define una " +
      "variable independiente, mide una variable dependiente, controla " +
      "factores relevantes, repite las pruebas y registra los datos. " +
      "Compara los resultados con la hipótesis y comunica también " +
      "la incertidumbre y las posibles fuentes de error."]
  ];

  for(const [pattern, answer] of answers){
    if(pattern.test(s)) return answer;
  }

  return "Interesante pregunta: \"" + q + "\".\n\n" +
    "Mi motor local todavía no contiene una respuesta específica " +
    "para este tema. Podemos investigarlo definiendo los conceptos, " +
    "identificando evidencias y construyendo una explicación paso a paso. " +
    "Para consultar conocimientos amplios y actualizados, conecta " +
    "CHARLOT a un modelo de IA mediante un servidor seguro.";
}

async function getAnswer(q){
  // Opcional: crea tu backend y cambia USE_API a true.
  const USE_API = false;

  if(USE_API){
    const response = await fetch("/api/chat", {
      method:"POST",
      headers:{"Content-Type":"application/json"},
      body:JSON.stringify({
        message:q,
        level:Number(level.value),
        history:history.slice(-10)
      })
    });
    if(!response.ok) throw new Error("Error del servidor de IA");
    const data = await response.json();
    if(typeof data.answer !== "string") throw new Error("Respuesta inválida");
    return data.answer;
  }

  return localBrain(q);
}

async function ask(q){
  q = q.trim();
  if(!q) return;

  lastQuestion = q;
  addMessage(q, "user");
  $("question").value = "";
  const pending = addMessage("Estoy analizando la pregunta...", "bot");

  try{
    const raw = await getAnswer(q);
    const answer = adapt(raw);
    pending.textContent = answer;
    lastAnswer = answer;
    history.push({role:"user", content:q});
    history.push({role:"assistant", content:answer});
    if(history.length > 20) history = history.slice(-20);
    speak(answer);
  }catch(error){
    pending.textContent = "No pude conectar con el motor de IA. " +
      "Comprueba el servidor e inténtalo de nuevo.";
    console.error(error);
  }
}

$("form").addEventListener("submit", e => {
  e.preventDefault();
  ask($("question").value);
});

$("easier").addEventListener("click", () => {
  level.value = String(Math.max(1, Number(level.value)-1));
  updateLevel();
  if(lastQuestion) ask("Explica de manera más sencilla: " + lastQuestion);
});

$("harder").addEventListener("click", () => {
  level.value = String(Math.min(4, Number(level.value)+1));
  updateLevel();
  if(lastQuestion) ask("Explica con mayor profundidad científica: " + lastQuestion);
});

$("listen").addEventListener("click", () => {
  const SpeechRecognition =
    window.SpeechRecognition || window.webkitSpeechRecognition;

  if(!SpeechRecognition){
    $("status").textContent =
      "Reconocimiento de voz no compatible. Prueba Chrome.";
    return;
  }

  if(recognition) recognition.stop();
  recognition = new SpeechRecognition();
  recognition.lang = "es-CO";
  recognition.interimResults = false;
  recognition.continuous = false;

  recognition.onstart = () => {
    $("status").textContent = "🎙️ Te estoy escuchando...";
    $("avatar").textContent = "👂";
  };
  recognition.onresult = e => ask(e.results[0][0].transcript);
  recognition.onerror = e => {
    $("status").textContent = "Voz: " + e.error;
  };
  recognition.onend = () => {
    $("avatar").textContent = "🤖";
    if(!speechSynthesis.speaking)
      $("status").textContent = "Sistema preparado";
  };
  recognition.start();
});

$("stop").addEventListener("click", () => {
  if("speechSynthesis" in window) speechSynthesis.cancel();
  if(recognition) recognition.stop();
  $("status").textContent = "Voz detenida";
  $("avatar").textContent = "🤖";
});

$("clear").addEventListener("click", () => {
  chat.replaceChildren();
  history = [];
  lastQuestion = "";
  lastAnswer = "";
  speechSynthesis?.cancel();
  addMessage("Sesión nueva. ¡Hola! Soy CHARLOT. " +
    "Pregúntame algo y exploraremos la respuesta juntos.");
});

$("startCamera").addEventListener("click", async () => {
  try{
    if(!navigator.mediaDevices?.getUserMedia)
      throw new Error("Usa HTTPS o localhost para acceder a la cámara.");

    stream = await navigator.mediaDevices.getUserMedia({
      video:{facingMode:"environment"}, audio:false
    });
    $("camera").srcObject = stream;
    $("visionStatus").textContent = "Cámara activa en este dispositivo.";
  }catch(error){
    $("visionStatus").textContent =
      "No se pudo activar la cámara: " + error.message;
  }
});

$("snapshot").addEventListener("click", () => {
  const video = $("camera");
  if(!video.videoWidth){
    $("visionStatus").textContent =
      "Activa la cámara y espera a que aparezca la imagen.";
    return;
  }

  const canvas = $("canvas");
  canvas.width = video.videoWidth;
  canvas.height = video.videoHeight;
  canvas.getContext("2d").drawImage(video,0,0);
  $("photo").src = canvas.toDataURL("image/jpeg",0.85);
  $("photo").hidden = false;
  $("visionStatus").textContent =
    "Imagen capturada localmente. Aún no se ha analizado con IA.";
});

$("stopCamera").addEventListener("click", () => {
  if(stream) stream.getTracks().forEach(track => track.stop());
  stream = null;
  $("camera").srcObject = null;
  $("visionStatus").textContent = "Cámara apagada.";
});

addMessage("¡Hola! Soy CHARLOT, tu asistente adaptativo. " +
  "Puedo conversar, hablar y ayudarte a explorar conceptos científicos. " +
  "Selecciona tu nivel y haz tu primera pregunta.");
</script>
</body>
</html>
